---
// Responsive WebP image: every asset under /assets/ has a full and a `-small` variant.
interface Props {
  src: string; alt?: string; sizes?: string; width?: number; height?: number;
  eager?: boolean; class?: string; position?: string;
}
const { src, alt = '', sizes = '100vw', width = 1600, height = 1067, eager = false, class: className, position } = Astro.props;
const base = `/assets/${src}`;
---
<img
  src={`${base}.webp`}
  srcset={`${base}-small.webp 720w, ${base}.webp 1600w`}
  sizes={sizes} alt={alt} width={width} height={height}
  loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : undefined}
  class={className} style={position ? `object-position:${position}` : undefined}
/>
