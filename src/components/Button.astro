---
import Icon from './Icon.astro';
interface Props { href: string; variant?: 'primary' | 'outline' | 'light' | 'ghost'; size?: 'sm' | 'md'; icon?: string; class?: string; [key: string]: unknown; }
const { href, variant = 'primary', size = 'md', icon = 'arrow', class: className = '', ...rest } = Astro.props;
---
<a href={href} class:list={['btn', variant !== 'primary' && `btn-${variant}`, size === 'sm' && 'btn-sm', className]} {...rest}><span><slot /></span><Icon name={icon} size={18} /></a>
